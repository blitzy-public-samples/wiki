{
	"name": "Blitzy",
	"private": true,
	"scripts": {
		"lint": "npm -s run lint:js && npm -s run lint:styles && npm -s run lint:i18n",
		"lint:i18n": "banana-checker i18n/",
		"lint:js": "eslint --cache --max-warnings 0 .",
		"lint:styles": "stylelint --cache --max-warnings 0 \"**/*.{less,css}\"",
		"test": "npm -s run lint && npm -s run check-pins && npm -s run token-audit && npm -s run test:qunit && npm -s run test:playwright",
		"test:axe": "playwright test tests/playwright/axe.spec.ts",
		"test:capture": "playwright test tests/playwright/capture.spec.ts",
		"test:domContract": "playwright test tests/playwright/domContract.spec.ts",
		"test:externalOrigins": "playwright test tests/playwright/externalOrigins.spec.ts",
		"test:fidelity": "playwright test tests/playwright/fidelity.spec.ts",
		"test:measurement-768": "playwright test tests/playwright/measurement-768.spec.ts",
		"test:nojs": "playwright test tests/playwright/nojs.spec.ts",
		"test:playwright": "playwright test",
		"test:qunit": "karma start karma.conf.js --single-run",
		"byte-identity": "node tools/byte-identity.js",
		"check-pins": "node tools/check-pins.js",
		"contrast-report": "node tools/contrast-report.js",
		"gallery": "node tools/gallery.js",
		"perf-baseline": "node tools/perf-baseline.js",
		"token-audit": "node tools/token-audit.js"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.62.1",
		"@wikimedia/mw-node-qunit": "7.10.0",
		"eslint": "8.57.1",
		"eslint-config-wikimedia": "0.32.5",
		"grunt-banana-checker": "0.13.0",
		"karma": "6.4.1",
		"karma-chrome-launcher": "3.1.0",
		"karma-coverage": "2.2.1",
		"karma-qunit": "4.2.0",
		"playwright": "1.62.1",
		"qunit": "2.26.0",
		"stylelint": "17.6.0",
		"stylelint-config-wikimedia": "0.19.3"
	}
}
