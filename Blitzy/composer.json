{
	"name": "mediawiki/blitzy-skin",
	"type": "mediawiki-skin",
	"description": "MediaWiki skin rendering content in the Blitzy web design language",
	"keywords": [
		"wiki",
		"MediaWiki",
		"skin"
	],
	"license": "GPL-2.0-or-later",
	"require": {
		"composer/installers": "2.3.0"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "52.0.0",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"extra": {
		"installer-name": "Blitzy"
	},
	"scripts": {
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"test": [
			"parallel-lint . --exclude node_modules --exclude vendor",
			"@phpcs",
			"minus-x check ."
		],
		"phan": "phan -d . --long-progress-bar",
		"phpcs": "phpcs -sp --cache"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
