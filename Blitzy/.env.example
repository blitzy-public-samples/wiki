# Blitzy skin — verification harness environment template
# ========================================================
#
# Copy this file to `.env` beside it, fill in the two blank values, and run the
# harness from the package root:
#
#     cp .env.example .env
#     harness/verify.sh
#
# This template is the committed deliverable; the populated `.env` is ignored by
# `.gitignore` and must never be committed. Never put a real credential in this
# file — only in your own `.env`.
#
# Every variable below configures the verification harness. None is read by the
# shipped skin, and none of them writes anything into `mediawiki/`: the skin is
# registered by the harness-generated `LocalSettings.php`, which is the
# sanctioned integration point (R1 Core Immutability). No variable may point at
# an origin outside the wiki itself (R5 Zero External Origins).
#
# Read sites, so every variable can be traced from write site to read site:
#
#     harness/docker-compose.yml           the digest-pinned container stack
#     harness/provision.sh                 install, import, fixture authoring
#     harness/verify.sh                    the single documented entry point
#     harness/LocalSettings.template.php   the generated site configuration
#     playwright.config.ts                 capture, audit and measurement runs
#     the in-wiki QUnit run                MediaWiki core itself reads MW_SERVER
#                                          and MW_SCRIPT_PATH to build the
#                                          Special:JavaScriptTest export URL
#
# File format, deliberately strict because four parsers read this file: Docker
# Compose, POSIX `sh` sourcing from the harness scripts, Node's `process.env`
# and PHP's `getenv()`.
#
#   * `KEY=value`, one per line. No `export`, no spaces around `=`.
#   * Comments occupy whole lines. A trailing `# ...` would be swallowed into
#     the value by Compose's parser.
#   * Values containing spaces are double-quoted, because `set -a; . ./.env`
#     otherwise splits them into words. Compose, `sh` and `bash` all strip the
#     quotes, so the string that reaches MediaWiki is identical either way.
#     Hand this file to a container through Compose, or through an environment
#     you sourced in the shell first: `docker run --env-file` is the one parser
#     that keeps the quotes, and it would pass MediaWiki a quoted string.
#   * The file is UTF-8 without a BOM. BLITZY_ANNOUNCE_TEXT contains a real em
#     dash (U+2014); substituting a hyphen changes the announcement bar in all
#     21 captures and breaks byte-identity against the committed baselines
#     (R9 Deterministic Captures).
#
# Exactly two variables have no default: MW_ADMIN_PASSWORD and
# BLITZY_TEST_PASSWORD. `harness/verify.sh` asserts both before it does anything
# else and exits with an error naming the one that is missing, so a blank left
# unfilled fails immediately and by name rather than midway through provisioning.

# -----------------------------------------------------------------------------
# Wiki URL contract
# -----------------------------------------------------------------------------

# Scheme, host and port of the verification wiki. Default: http://localhost:8080.
# Read by playwright.config.ts as the capture `baseURL`, by
# harness/LocalSettings.template.php as `$wgServer`, by harness/verify.sh's HTTP
# health probe, and by MediaWiki core when it builds the in-wiki QUnit URL. The
# port must match MW_DOCKER_PORT below; both are written literally rather than
# interpolated so that every parser resolves them identically.
MW_SERVER=http://localhost:8080

# Path the wiki is served under, without a trailing slash. Default: the empty
# string, quoted, because the pinned mediawiki:1.43.9 image serves MediaWiki at
# the web root, so `$wgScriptPath` is empty. Read as `$wgScriptPath` and
# `$wgResourceBasePath` by the settings template, and concatenated by core's
# QUnit tooling — keep the line even when empty, because an unset variable
# produces a broken test URL. The pretty article path is a separate setting the
# settings template owns, not an environment variable.
MW_SCRIPT_PATH=""

# Host port harness/docker-compose.yml publishes for the wiki container.
# Default: 8080, the same default MediaWiki core's own development stack uses.
# Change this and MW_SERVER together, for example when 8080 is already taken.
MW_DOCKER_PORT=8080

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Name of the MariaDB database the harness creates and installs into.
# Default: blitzy_verify. Read by harness/docker-compose.yml as
# `MARIADB_DATABASE`, by harness/provision.sh as `install.php --dbname`, and by
# harness/LocalSettings.template.php as `$wgDBname`.
# The database *credential* is deliberately not an operator input: it stays a
# Compose-internal default and the database port is never published outside the
# Compose network, so no database password is ever written to this file.
MW_DB_NAME=blitzy_verify

# -----------------------------------------------------------------------------
# Accounts
# -----------------------------------------------------------------------------

# Installer administrator, created by MediaWiki's installer while provisioning.
# Default: BlitzyInstaller — deliberately distinctive so a capture audit can
# grep the rendered HTML for it. THIS ACCOUNT MUST NEVER APPEAR IN ANY CAPTURE:
# harness/provision.sh attributes every seeded edit to BLITZY_TEST_USER via
# `maintenance/edit.php --user`, so the history and diff captures show the
# ordinary account and never the administrator.
MW_ADMIN_USER=BlitzyInstaller

# Password for MW_ADMIN_USER. REQUIRED, NO DEFAULT, SECRET — leave it blank here
# and set it only in your own `.env`. MediaWiki's default password policy
# requires at least 10 characters for accounts in the sysop group.
# harness/verify.sh asserts this variable before any other work and exits with
# an error naming MW_ADMIN_PASSWORD when it is missing or empty.
MW_ADMIN_PASSWORD=

# Ordinary, preferences-populated account used for all fifteen authenticated
# captures and credited as the author of every seeded edit. Default:
# BlitzyReviewer. This name is rendered chrome — it appears in the personal menu
# and in the history and diff captures — so treat it as a fixed string: changing
# it changes the captured bytes (R9 Deterministic Captures).
BLITZY_TEST_USER=BlitzyReviewer

# Password for BLITZY_TEST_USER. REQUIRED, NO DEFAULT, SECRET — leave it blank
# here and set it only in your own `.env`. At least 8 characters, MediaWiki's
# default policy for ordinary accounts. Playwright signs in with it once and
# reuses the stored session, and it is never rendered, so it does not affect
# byte-identity. harness/verify.sh asserts it alongside MW_ADMIN_PASSWORD and
# exits with an error naming BLITZY_TEST_PASSWORD when it is missing or empty.
BLITZY_TEST_PASSWORD=

# -----------------------------------------------------------------------------
# Announcement bar — verification instance only
# -----------------------------------------------------------------------------
#
# harness/LocalSettings.template.php applies these three values to
# `$wgBlitzyAnnounceEnable`, `$wgBlitzyAnnounceText` and
# `$wgBlitzyAnnounceLabel`. They configure the verification instance ONLY:
# skin.json ships `BlitzyAnnounceEnable` as false, so a wiki that merely installs
# the skin gets no announcement bar, and a disabled bar is omitted from the DOM
# entirely rather than hidden with CSS. All three are fixed strings, because the
# bar renders in every one of the 21 captures and byte-identity forbids variable
# chrome content (R9 Deterministic Captures). The button's link target is not an
# environment variable: the settings template sets `$wgBlitzyAnnounceLink` to a
# fixed site-relative path, which keeps this file at the eleven variables the
# specification allows (R12 No Scope Expansion).

# Renders the announcement bar above the navigation card. Fixed: true.
BLITZY_ANNOUNCE_ENABLE=true

# Announcement body text. Fixed string; the dash is U+2014 EM DASH, not a hyphen.
BLITZY_ANNOUNCE_TEXT="State of Wiki Engineering — Read the Notes"

# Label of the announcement call-to-action button. Fixed string.
BLITZY_ANNOUNCE_LABEL="Read Now"
